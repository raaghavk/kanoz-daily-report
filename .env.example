# Required for a live plant (never commit real keys).
# Leave these as placeholders — or omit them — to run the scrubbed prospect demo.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: VAPID public key for push notifications (unused in demo mode)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Prospect sales tour (this branch defaults ON).
#   VITE_DEMO_MODE=true npm run dev
# Uses fictional Shree Demo Bio Pellets / Riverside Demo Plant — Gorakhpur sample data. No live database, no Gemini key.
# Do not merge this demo branch to main.
VITE_DEMO_MODE=true
